@model RaceDayMvc.Models.EventViewModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Create New RaceDay Event</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., Cape Town Cycle Tour" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Date" class="form-label fw-bold"></label>
                                <input asp-for="Date" class="form-control" type="datetime-local" />
                                <span asp-validation-for="Date" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EventType" class="form-label fw-bold"></label>
                                <select asp-for="EventType" class="form-select">
                                    <option value="Run">Run</option>
                                    <option value="Walk">Walk</option>
                                    <option value="Cycle">Cycle</option>
                                </select>
                                <span asp-validation-for="EventType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="Location" class="form-label fw-bold"></label>
                                <input asp-for="Location" class="form-control" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Distance" class="form-label fw-bold">Distance (km)</label>
                                <input asp-for="Distance" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="Distance" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BannerImage" class="form-label fw-bold text-primary">Upload Azure Blob Banner Image</label>
                            <input asp-for="BannerImage" type="file" class="form-control" accept="image/*" />
                            <small class="text-muted">This image will be sent to the API and securely stored in Azure Blob Storage.</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">Save Event</button>
                            <a asp-action="ManageEvents" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>