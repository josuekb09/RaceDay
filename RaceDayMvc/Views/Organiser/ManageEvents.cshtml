@model IEnumerable<RaceDayMvc.Models.EventViewModel>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold">Manage Events</h2>
        <a asp-action="CreateEvent" class="btn btn-success fw-bold">+ Create New Event</a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                    {
                        <img src="@item.BannerImageUrl" class="card-img-top" alt="Event Banner" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex justify-content-center align-items-center" style="height: 200px;">
                            <span class="text-light">No Image Available</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-muted mb-1"><i class="bi bi-calendar"></i> @item.Date.ToShortDateString()</p>
                        <p class="card-text text-muted mb-3"><i class="bi bi-geo-alt"></i> @item.Location</p>
                        <span class="badge bg-success mb-2">@item.EventType</span>
                        <span class="badge bg-primary mb-2">@item.Distance km</span>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                        <a href="#" class="btn btn-outline-primary btn-sm">Edit</a>
                        <a href="#" class="btn btn-outline-secondary btn-sm">Categories</a>
                        <a href="#" class="btn btn-outline-danger btn-sm">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>