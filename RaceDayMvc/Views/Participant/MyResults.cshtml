@model IEnumerable<RaceDayMvc.Models.ResultViewModel>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold mb-4">My Race History</h2>

    <table class="table table-hover shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Category</th>
                <th>Finish Time</th>
                <th>Position</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model)
            {
                <tr>
                    <td class="fw-bold">@result.EventName</td>
                    <td>@result.Date.ToShortDateString()</td>
                    <td>@result.Category</td>
                    <td class="text-success fw-bold">@result.FinishTime</td>
                    <td><span class="badge bg-info text-dark">@result.FinishingPosition</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>